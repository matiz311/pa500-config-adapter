<?xml version="1.0"?>
<!-- Config sintetica con la struttura di un PA-550 in produzione con Advanced Routing (PAN-OS 12.1.7).
     Solo la struttura è presa dal dispositivo reale: nomi, indirizzi e valori sono inventati
     (RFC 5737 e reti private). Caratteristiche riprodotte:
     - advance-routing esplicito a yes, nessun network/virtual-router
     - logical router con VRF default, admin-dists esplicite con i default ARE (OSPF 110),
       blocchi bgp/ospf/ospfv3/rip/multicast presenti ma disattivati, ECMP disattivato
     - static route con bfd/profile None, route solo su interfaccia (senza nexthop)
       e route solo con nexthop (senza interfaccia)
     - path monitoring HA con path group logical-router e destination-ip-group
     - HA1 su porta dati con IP, HA1 backup sulla management, HA2 su SFP con lacp,
       HA2 backup nella stessa subnet di HA1
     - aggregata LACP sulle SFP+ 15-16, sub-interfacce con DHCP server e relay
     - vsys import con le sole interfacce (nessun router importato) -->
<config version="12.1.0" urldb="paloaltonetworks" detail-version="12.1.7">
  <devices>
    <entry name="localhost.localdomain">
      <deviceconfig>
        <system>
          <hostname>pa550-are</hostname>
          <ip-address>10.0.254.248</ip-address>
          <netmask>255.255.255.0</netmask>
          <default-gateway>10.0.254.254</default-gateway>
          <type><static/></type>
        </system>
        <setting>
          <advance-routing>yes</advance-routing>
          <session><tcp-reject-non-syn>no</tcp-reject-non-syn></session>
        </setting>
        <high-availability>
          <enabled>yes</enabled>
          <interface>
            <ha1><port>ethernet1/11</port><ip-address>172.16.255.1</ip-address><netmask>255.255.255.248</netmask><monitor-hold-time>5000</monitor-hold-time></ha1>
            <ha1-backup><port>management</port></ha1-backup>
            <ha2><port>ethernet1/14</port></ha2>
            <ha2-backup><port>ethernet1/12</port><ip-address>172.16.255.3</ip-address><netmask>255.255.255.248</netmask></ha2-backup>
          </interface>
          <group>
            <group-id>1</group-id>
            <description>coppia test</description>
            <peer-ip>172.16.255.2</peer-ip>
            <peer-ip-backup>10.0.254.249</peer-ip-backup>
            <mode><active-passive><passive-link-state>auto</passive-link-state></active-passive></mode>
            <monitoring>
              <path-monitoring>
                <enabled>yes</enabled>
                <path-group>
                  <logical-router>
                    <entry name="lr1">
                      <destination-ip-group>
                        <entry name="Core"><destination-ip><member>10.0.1.254</member></destination-ip><enabled>yes</enabled><failure-condition>any</failure-condition></entry>
                        <entry name="Internet"><destination-ip><member>203.0.113.1</member></destination-ip><enabled>yes</enabled><failure-condition>any</failure-condition></entry>
                      </destination-ip-group>
                      <failure-condition>any</failure-condition>
                    </entry>
                  </logical-router>
                </path-group>
              </path-monitoring>
              <link-monitoring>
                <enabled>yes</enabled>
                <link-group>
                  <entry name="Uplink-15"><interface><member>ethernet1/15</member></interface></entry>
                  <entry name="Uplink-16"><enabled>yes</enabled><interface><member>ethernet1/16</member></interface></entry>
                </link-group>
              </link-monitoring>
            </monitoring>
          </group>
        </high-availability>
      </deviceconfig>
      <network>
        <interface>
          <ethernet>
            <entry name="ethernet1/1"><link-state>auto</link-state></entry>
            <entry name="ethernet1/5"><virtual-wire/><comment>vw lato A</comment></entry>
            <entry name="ethernet1/6"><virtual-wire/><comment>vw lato B</comment></entry>
            <entry name="ethernet1/11"><comment>HA1</comment><ha/></entry>
            <entry name="ethernet1/12"><comment>HA2 backup</comment><ha/></entry>
            <entry name="ethernet1/14"><lacp><port-priority>32768</port-priority></lacp><ha/><comment>HA2</comment></entry>
            <entry name="ethernet1/15"><aggregate-group>ae1</aggregate-group><comment>uplink A</comment></entry>
            <entry name="ethernet1/16"><comment>uplink B</comment><aggregate-group>ae1</aggregate-group><link-speed>auto</link-speed></entry>
          </ethernet>
          <aggregate-ethernet>
            <entry name="ae1">
              <layer3>
                <lacp><enable>yes</enable><mode>active</mode><transmission-rate>fast</transmission-rate></lacp>
                <units>
                  <entry name="ae1.1"><ip><entry name="10.0.1.253/24"/></ip><tag>1</tag></entry>
                  <entry name="ae1.21"><ip><entry name="10.0.21.254/24"/></ip><tag>21</tag></entry>
                  <entry name="ae1.103"><ip><entry name="10.0.103.254/24"/></ip><tag>103</tag></entry>
                  <entry name="ae1.777"><ip><entry name="203.0.113.2/29"/></ip><tag>777</tag></entry>
                </units>
              </layer3>
            </entry>
          </aggregate-ethernet>
          <loopback><units><entry name="loopback.10"><ip><entry name="198.51.100.10"/></ip></entry></units></loopback>
        </interface>
        <virtual-wire><entry name="vw1"><interface1>ethernet1/5</interface1><interface2>ethernet1/6</interface2></entry></virtual-wire>
        <logical-router>
          <entry name="lr1">
            <vrf>
              <entry name="default">
                <multicast><pim><enable>yes</enable></pim><igmp><enable>yes</enable></igmp><msdp><enable>no</enable></msdp><enable>no</enable></multicast>
                <ecmp><algorithm><ip-modulo/></algorithm><symmetric-return>no</symmetric-return><strict-source-path>no</strict-source-path><enable>no</enable><max-path>2</max-path></ecmp>
                <bgp>
                  <med><always-compare-med>no</always-compare-med><deterministic-med-comparison>yes</deterministic-med-comparison></med>
                  <graceful-restart><stale-route-time>120</stale-route-time><max-peer-restart-time>120</max-peer-restart-time><enable>yes</enable><local-restart-time>120</local-restart-time></graceful-restart>
                  <global-bfd><profile>None</profile></global-bfd>
                  <install-route>no</install-route>
                  <enforce-first-as>yes</enforce-first-as>
                  <enable>no</enable>
                  <default-local-preference>100</default-local-preference>
                </bgp>
                <routing-table>
                  <ip>
                    <static-route>
                      <entry name="default"><bfd><profile>None</profile></bfd><nexthop><ip-address>203.0.113.1</ip-address></nexthop><interface>ae1.777</interface><destination>0.0.0.0/0</destination><metric>1</metric></entry>
                      <entry name="lan"><bfd><profile>None</profile></bfd><nexthop><ip-address>10.0.1.254</ip-address></nexthop><interface>ae1.1</interface><destination>10.10.0.0/16</destination><metric>1</metric></entry>
                      <entry name="solo-interfaccia"><bfd><profile>None</profile></bfd><interface>ae1.21</interface><destination>10.21.0.0/24</destination><metric>1</metric></entry>
                      <entry name="solo-nexthop"><bfd><profile>None</profile></bfd><nexthop><ip-address>10.0.103.1</ip-address></nexthop><destination>10.60.10.0/24</destination><metric>10</metric></entry>
                    </static-route>
                  </ip>
                </routing-table>
                <ospfv3><global-bfd><profile>None</profile></global-bfd><enable>no</enable><disable-transit-traffic>no</disable-transit-traffic></ospfv3>
                <rip><global-bfd><profile>None</profile></global-bfd><default-information-originate>no</default-information-originate><enable>no</enable></rip>
                <ospf><global-bfd><profile>None</profile></global-bfd><enable>no</enable><rfc1583>no</rfc1583></ospf>
                <admin-dists>
                  <ospf-intra>110</ospf-intra><ospf-inter>110</ospf-inter><ospf-ext>110</ospf-ext>
                  <ospfv3-intra>110</ospfv3-intra><ospfv3-inter>110</ospfv3-inter><ospfv3-ext>110</ospfv3-ext>
                  <bgp-internal>200</bgp-internal><bgp-external>20</bgp-external><bgp-local>20</bgp-local>
                  <rip>120</rip><static>10</static><static-ipv6>10</static-ipv6>
                </admin-dists>
                <interface>
                  <member>ae1</member><member>ae1.1</member><member>ae1.21</member><member>ae1.103</member><member>ae1.777</member><member>loopback.10</member>
                </interface>
              </entry>
            </vrf>
          </entry>
        </logical-router>
        <dhcp>
          <interface>
            <entry name="ae1.103"><relay><ip><enabled>yes</enabled><server><member>10.0.1.10</member></server></ip></relay></entry>
            <entry name="ae1.21"><server><mode>auto</mode><ip-pool><member>10.0.21.100-10.0.21.200</member></ip-pool></server></entry>
          </interface>
        </dhcp>
      </network>
      <vsys>
        <entry name="vsys1">
          <import><network><interface>
            <member>ae1</member><member>ae1.1</member><member>ae1.21</member><member>ae1.103</member><member>ae1.777</member>
            <member>ethernet1/5</member><member>ethernet1/6</member><member>loopback.10</member>
          </interface></network></import>
          <zone>
            <entry name="trust"><network><layer3><member>ae1.1</member><member>ae1.21</member><member>ae1.103</member></layer3></network></entry>
            <entry name="untrust"><network><layer3><member>ae1.777</member></layer3></network></entry>
            <entry name="vw-a"><network><virtual-wire><member>ethernet1/5</member></virtual-wire></network></entry>
            <entry name="vw-b"><network><virtual-wire><member>ethernet1/6</member></virtual-wire></network></entry>
          </zone>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
