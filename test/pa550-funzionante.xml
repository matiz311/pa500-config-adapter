<?xml version="1.0"?>
<!-- Config sintetica con la struttura di un PA-550 in produzione (PAN-OS 12.1.3):
     nessun advance-routing esplicito, virtual-router vuoto, HA1 su porta dati, HA1 backup
     sulla management, HA2 backup nella stessa /29 di HA1, aggregata LACP sulle SFP 13-14. -->
<config urldb="paloaltonetworks" version="12.1.0" detail-version="12.1.3">
  <devices>
    <entry name="localhost.localdomain">
      <network>
        <interface>
          <ethernet>
            <entry name="ethernet1/1"><link-state>auto</link-state></entry>
            <entry name="ethernet1/7"><link-state>auto</link-state><comment>HA spare</comment><ha/><link-duplex>auto</link-duplex><link-speed>auto</link-speed></entry>
            <entry name="ethernet1/5"><virtual-wire/></entry>
            <entry name="ethernet1/6"><virtual-wire/></entry>
            <entry name="ethernet1/11"><comment>HA1</comment><ha/></entry>
            <entry name="ethernet1/12"><comment>HA2 backup</comment><ha/></entry>
            <entry name="ethernet1/13"><aggregate-group>ae1</aggregate-group></entry>
            <entry name="ethernet1/14"><aggregate-group>ae1</aggregate-group></entry>
            <entry name="ethernet1/16"><comment>HA2</comment><ha/></entry>
          </ethernet>
          <aggregate-ethernet>
            <entry name="ae1">
              <layer3>
                <lacp><enable>yes</enable><mode>active</mode><transmission-rate>fast</transmission-rate></lacp>
                <units>
                  <entry name="ae1.1"><ip><entry name="10.0.1.253/24"/></ip><tag>1</tag></entry>
                  <entry name="ae1.2"><ip><entry name="10.0.2.253/24"/></ip><tag>2</tag></entry>
                </units>
              </layer3>
            </entry>
          </aggregate-ethernet>
        </interface>
        <virtual-wire><entry name="vw-test"><interface1>ethernet1/5</interface1><interface2>ethernet1/6</interface2></entry></virtual-wire>
        <virtual-router/>
      </network>
      <deviceconfig>
        <system><hostname>pa550-a</hostname><ip-address>10.0.254.251</ip-address><netmask>255.255.255.0</netmask><type><static/></type></system>
        <setting><config><rematch>yes</rematch></config></setting>
        <high-availability>
          <enabled>yes</enabled>
          <interface>
            <ha1><port>ethernet1/11</port><ip-address>192.168.255.251</ip-address><netmask>255.255.255.248</netmask></ha1>
            <ha1-backup><port>management</port></ha1-backup>
            <ha2><port>ethernet1/16</port></ha2>
            <ha2-backup><port>ethernet1/12</port><ip-address>192.168.255.253</ip-address><netmask>255.255.255.248</netmask></ha2-backup>
          </interface>
          <group>
            <group-id>1</group-id><peer-ip>192.168.255.252</peer-ip><peer-ip-backup>10.0.254.252</peer-ip-backup>
            <mode><active-passive/></mode>
            <monitoring>
              <path-monitoring><enabled>no</enabled><path-group><virtual-router/></path-group></path-monitoring>
              <link-monitoring><enabled>yes</enabled><link-group><entry name="PortChannel"><interface><member>ethernet1/13</member><member>ethernet1/14</member></interface></entry></link-group></link-monitoring>
            </monitoring>
          </group>
        </high-availability>
      </deviceconfig>
      <vsys>
        <entry name="vsys1">
          <import><network><interface><member>ae1</member><member>ae1.1</member><member>ae1.2</member></interface></network></import>
          <zone>
            <entry name="trust"><network><layer3><member>ae1.1</member></layer3></network></entry>
            <entry name="guest"><network><layer3><member>ae1.2</member></layer3></network></entry>
          </zone>
        </entry>
      </vsys>
    </entry>
  </devices>
</config>
